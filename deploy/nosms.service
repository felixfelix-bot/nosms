[Unit]
Description=nosms - SMS for nostr keys (cashu.email parity)
Documentation=https://nosms.orangesync.tech/llms.txt
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nosms
Group=nosms
WorkingDirectory=/opt/nosms
EnvironmentFile=/etc/nosms.env
# Configuration lives in /etc/nosms.env (NOSMS_COMMIT, NOSMS_TRANSPORT,
# NOSMS_ENV, NOSMS_VERSION, and for M1b: NOSMS_MINT_URL, NOSMS_DB_PATH,
# NOSMS_REFUND_AFTER_SECONDS, NOSMS_DESTINATION_COOLDOWN_SECONDS, NOSMS_DAILY_CAP,
# NOSMS_SMS_GATEWAY_PATH, TELNYX_API_KEY, TELNYX_FROM_NUMBER,
# TELNYX_MESSAGING_PROFILE_ID). No secret is ever placed in this unit file.
# The refund sweep runs from nosms-refund-sweep.timer against the same env file.
ExecStart=/opt/nosms/.venv/bin/uvicorn server:app --host 127.0.0.1 --port 8088 --log-level info
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nosms
StateDirectory=nosms

[Install]
WantedBy=multi-user.target
